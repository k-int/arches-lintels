#MainWindow {
    background-color: #fff;
}
#menuButton {
    padding: 5px;
    border: none;
    width: 30px;
    height: 30px;
}

#widget {
    background-color: #f9fafd;
}

#iconOnlyMenu {
    background-color: #313a46;
    width:50px;
}

#fullMenu QPushButton, QLabel,
#iconOnlyMenu QPushButton, QLabel {
    height:30px;
    border:none;
    border-radius: 3px;
    text-align: left;
    padding: 8px 0 8px 15px;
    color: #788596;
}

#fullMenu QPushButton:hover,
#iconOnlyMenu QPushButton:hover {
    background-color: rgba(86, 101, 115, 0.5);
}

#logo_label_1 {
    padding: 5px
}

#fullMenu {
    background-color: #313a46;
}


#fullMenu QPushButton:checked {
    color: #fff;
}

#logo_label_2 {
    padding: 5px;
    color: #fff;
}

#logo_label_3 {
    padding-right: 10px;
    color: #fff;
}

